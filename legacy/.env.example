# Never put these values in dist/ or browser code.
PORT=4173
COOKIE_SECURE=false
NOVA_DB_PATH=nova.db

# An OpenAI-compatible chat-completions endpoint. Use one or more server-only
# provider keys separated by commas for failover. With these empty, the app has
# a clearly labelled local development generator.
AI_API_URL=
AI_API_KEYS=
AI_MODEL=

# Create the first administrator on initial database setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
