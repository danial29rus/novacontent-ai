# ─────────────────────────────────────────────────────────────────────────────
# Nova AI · настройки. На сервере создайте .env командой:  ./scripts/init-env.sh
# Ключи и пароли хранятся только на сервере и никогда не попадают в браузер.
# ─────────────────────────────────────────────────────────────────────────────

# --- Домен и HTTPS (Caddy сам выпустит сертификат Let's Encrypt)
# Локально:  SITE_ADDRESS=http://localhost  PUBLIC_URL=http://localhost  HTTP_PORT=80
SITE_ADDRESS=24nova-ai.ru, www.24nova-ai.ru
PUBLIC_URL=https://24nova-ai.ru
ACME_EMAIL=support@24nova-ai.ru
CORS_ORIGINS=["https://24nova-ai.ru"]
ENVIRONMENT=production
COOKIE_SECURE=true

# --- База данных (сгенерируйте: openssl rand -hex 24)
POSTGRES_PASSWORD=CHANGE_ME

# --- Первый администратор (создаётся при первом запуске, если его нет)
ADMIN_EMAIL=admin@24nova-ai.ru
ADMIN_PASSWORD=CHANGE_ME_TO_12_PLUS_CHARS

# --- OpenAI (обязательно для продакшена: без ключа чат вернёт «модель недоступна»)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-gateway/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Почта (Timeweb): ящик support@24nova-ai.ru, создаётся в панели Timeweb → Почта
SUPPORT_EMAIL=support@24nova-ai.ru
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=support@24nova-ai.ru
SMTP_PASSWORD=
SMTP_FROM=support@24nova-ai.ru

# --- Оплата: пока новая система не подключена, оставьте mock. В продакшене пополнение будет закрыто.
PAYMENT_PROVIDER=mock

# --- Бэкапы Postgres (сервис backup): ежедневно, проверка дампа, хранение N дней
TZ=Europe/Moscow
BACKUP_TIME=04:00
BACKUP_KEEP_DAYS=14
# Копия вне сервера: Timeweb Cloud → Хранилище S3 → бакет и ключи доступа. Пусто = только локально.
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Экономика
WELCOME_TOKENS=50
USD_RUB=95
REFERRAL_SIGNUP_BONUS=50
REFERRAL_PERCENT=10

# --- Контекст чатов и RAG
CONTEXT_BUDGET_TOKENS=12000
SUMMARY_TRIGGER_MESSAGES=24
RAG_TOP_K=5
